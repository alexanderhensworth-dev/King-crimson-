--[[
    KING CRIMSON - CORRECTED AURA & IMAGE UI
    - Reverted Aura Logic to Asset 10953055906 original behavior
    - Draggable ImageButton (writefile + getcustomasset)
    - Facing Backward behind player
]]

local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local rootPart = character:WaitForChild("HumanoidRootPart")
local camera = game.Workspace.CurrentCamera

local stand = nil
local ignoredParts = {}
local auraParticles = {} 
local isSummoned = false
local currentTransparency = 1
local lerpPos = Vector3.new(0, 0, 0)

-------------------------------------------------------------------
-- 1. ASSET DOWNLOADING (Image Button)
-------------------------------------------------------------------
local imageName = "KC_Icon_Asset.png"
local imageUrl = "https://raw.githubusercontent.com/alexanderhensworth-dev/King-crimson-/main/1_20260503_010006_0000-removebg-preview.png"

if not isfile(imageName) then
    writefile(imageName, game:HttpGet(imageUrl))
end
local assetId = getcustomasset(imageName)

-------------------------------------------------------------------
-- 2. AURA APPLICATION (Original Logic Reverted)
-------------------------------------------------------------------
local function ApplyAura(targetModel, auraName)
    local Object = game:GetObjects("rbxassetid://10953055906")[1]
    Object.Name = auraName
    Object.Parent = targetModel 

    local airPhysics = PhysicalProperties.new(0.0001, 0, 0, 0, 0)
    local redColor = ColorSequence.new(Color3.fromRGB(255, 0, 0))

    for _, auraPart in ipairs(Object:GetDescendants()) do
        if auraPart:IsA("Humanoid") then auraPart:Destroy() end

        if auraPart:IsA("ParticleEmitter") then
            auraPart.Color = redColor
            auraPart.Enabled = false 
            table.insert(auraParticles, auraPart)
        end

        if auraPart:IsA("BasePart") then
            auraPart.Anchored = false
            auraPart.CanCollide = false
            auraPart.Massless = true 
            auraPart.CustomPhysicalProperties = airPhysics 
            auraPart.Transparency = 1 

            local cleanName = auraPart.Name:gsub(" ", ""):lower()
            local targetLimb = nil
            
            for _, v in ipairs(targetModel:GetDescendants()) do
                if v:IsA("BasePart") then
                    local vName = v.Name:gsub(" ", ""):lower()
                    if vName == cleanName then
                        targetLimb = v
                        break
                    end
                end
            end

            if not targetLimb then
                targetLimb = targetModel:FindFirstChild("Torso") or 
                             targetModel:FindFirstChild("UpperTorso") or 
                             (targetModel:IsA("Model") and targetModel.PrimaryPart) or 
                             rootPart
            end

            if targetLimb then
                auraPart.CFrame = targetLimb.CFrame
                local weld = Instance.new("WeldConstraint")
                weld.Part0 = targetLimb
                weld.Part1 = auraPart
                weld.Parent = auraPart
            end
        end
    end
end

-------------------------------------------------------------------
-- 3. STAND CREATION
-------------------------------------------------------------------
local function CreateStand()
    if stand then stand:Destroy() end
    auraParticles = {} 
    
    stand = game:GetObjects("rbxassetid://9647642088")[1]
    stand.Name = "KingCrimson"
    stand.Parent = camera 
    
    local mainPart = nil
    ignoredParts = {}

    for _, part in ipairs(stand:GetDescendants()) do
        if part:IsA("BasePart") then
            if part.Name == "HumanoidRootPart" or part.Name:lower():find("hitbox") or part.Transparency >= 0.5 then
                part.Transparency = 1
                ignoredParts[part] = true
            end
            if not mainPart and not ignoredParts[part] then mainPart = part end
            
            part.Anchored = true
            part.CanCollide = false
            part.Massless = true
            if not ignoredParts[part] then part.Transparency = 1 end
            
            if part ~= mainPart then
                local weld = Instance.new("WeldConstraint")
                weld.Part0 = part
                weld.Part1 = mainPart
                weld.Parent = part
                part.Anchored = false
            end
        end
    end
    stand.PrimaryPart = mainPart
    
    ApplyAura(character, "PlayerAura")
    ApplyAura(stand, "StandAura")
end

CreateStand()

-------------------------------------------------------------------
-- 4. DRAGGABLE IMAGE GUI
-------------------------------------------------------------------
local playerGui = player:WaitForChild("PlayerGui")
local screenGui = playerGui:FindFirstChild("KC_GUI") or Instance.new("ScreenGui", playerGui)
screenGui.Name = "KC_GUI"
screenGui.ResetOnSpawn = false

local imgBtn = Instance.new("ImageButton", screenGui)
imgBtn.Name = "SummonBtn"
imgBtn.Size = UDim2.new(0, 85, 0, 85)
imgBtn.Position = UDim2.new(0.5, -42, 0.8, 0)
imgBtn.Image = assetId
imgBtn.BackgroundTransparency = 1

-- Custom Drag Logic
local dragging, dragInput, dragStart, startPos
imgBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = imgBtn.Position
    end
end)
game:GetService("UserInputService").InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        imgBtn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)
game:GetService("UserInputService").InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

imgBtn.MouseButton1Click:Connect(function()
    isSummoned = not isSummoned
    imgBtn.ImageColor3 = isSummoned and Color3.fromRGB(255, 100, 100) or Color3.new(1, 1, 1)
    for _, p in ipairs(auraParticles) do
        p.Enabled = isSummoned
    end
end)

-------------------------------------------------------------------
-- 5. MAIN LOOP
-------------------------------------------------------------------
RunService.RenderStepped:Connect(function()
    if not stand or not stand.Parent then CreateStand() return end

    local targetAlpha = isSummoned and 0 or 1
    local targetOffset = isSummoned and Vector3.new(0, 1.8, 2.5) or Vector3.new(0, 0, 0)
    
    currentTransparency = math.lerp(currentTransparency, targetAlpha, 0.35)
    lerpPos = lerpPos:Lerp(targetOffset, 0.25)
    
    local hover = math.sin(tick() * 2) * 0.4
    local finalCFrame = rootPart.CFrame * CFrame.new(lerpPos + Vector3.new(0, hover, 0)) * CFrame.Angles(0, math.rad(180), 0)
    
    stand:PivotTo(finalCFrame)
    
    for _, item in ipairs(stand:GetDescendants()) do
        if not ignoredParts[item] and not item:IsDescendantOf(stand:FindFirstChild("StandAura")) then
            if item:IsA("BasePart") or item:IsA("Decal") or item:IsA("Texture") then
                item.Transparency = currentTransparency
            end
        end
    end
end)
