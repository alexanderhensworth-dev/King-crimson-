--[[
    KING CRIMSON - DRAG FIX & AUDIO RESET
    - Fixed Draggable Button logic (Added Touch support + robust Delta)
    - Resetting/Dying triggers full audio on next summon
    - Repeat summons (while alive) play for 1.32s
    - Camera-parented (No player anchoring)
]]

local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local function InitializeKC(character)
    local rootPart = character:WaitForChild("HumanoidRootPart")
    local humanoid = character:WaitForChild("Humanoid")
    
    local isFirstSummonThisLife = true
    local stand = nil
    local ignoredParts = {}
    local auraParticles = {} 
    local isSummoned = false
    local currentTransparency = 1
    local lerpPos = Vector3.new(0, 0, 0)

    -------------------------------------------------------------------
    -- 1. ASSETS
    -------------------------------------------------------------------
    local audioName = "KC_Final_Sync_v4.mp3"
    local audioUrl = "https://raw.githubusercontent.com/alexanderhensworth-dev/King-crimson-/main/YTDown_Shorts_King-Crimson-anime-animeedit-amv-animeam_Media_jkFrDUvyVcc_008_128k.mp3"
    local imageName = "KC_Icon_Final_Ghost.png"
    local imageUrl = "https://raw.githubusercontent.com/alexanderhensworth-dev/King-crimson-/main/1_20260503_010006_0000-removebg-preview.png"

    if not isfile(audioName) then writefile(audioName, game:HttpGet(audioUrl)) end
    if not isfile(imageName) then writefile(imageName, game:HttpGet(imageUrl)) end

    local audioAsset = getcustomasset(audioName)
    local imageAsset = getcustomasset(imageName)

    local summonSound = Instance.new("Sound", rootPart)
    summonSound.SoundId = audioAsset
    summonSound.Volume = 1

    -------------------------------------------------------------------
    -- 2. AURA & STAND (CAMERA PARENTED)
    -------------------------------------------------------------------
    local function ApplyAura(targetModel, auraName)
        local Object = game:GetObjects("rbxassetid://10953055906")[1]
        Object.Name = auraName
        Object.Parent = targetModel 
        for _, auraPart in ipairs(Object:GetDescendants()) do
            if auraPart:IsA("Humanoid") then auraPart:Destroy() end
            if auraPart:IsA("ParticleEmitter") then
                auraPart.Color = ColorSequence.new(Color3.fromRGB(255, 0, 0))
                auraPart.Enabled = false 
                table.insert(auraParticles, auraPart)
            end
            if auraPart:IsA("BasePart") then
                auraPart.CanCollide, auraPart.CanTouch, auraPart.CanQuery = false, false, false
                auraPart.Anchored, auraPart.Massless = false, true 
                auraPart.Transparency = 1 
                local search = auraPart.Name:lower():gsub(" ", "")
                local target = nil
                for _, v in ipairs(targetModel:GetDescendants()) do
                    if v:IsA("BasePart") and not v:IsDescendantOf(Object) and v.Name:lower():gsub(" ", "") == search then
                        target = v break
                    end
                end
                target = target or targetModel:FindFirstChild("Torso") or rootPart
                if target then
                    auraPart.CFrame = target.CFrame
                    local weld = Instance.new("WeldConstraint", auraPart)
                    weld.Part0, weld.Part1 = target, auraPart
                end
            end
        end
    end

    local function CreateStand()
        if stand then stand:Destroy() end
        auraParticles = {} 
        stand = game:GetObjects("rbxassetid://9647642088")[1]
        stand.Name = "KingCrimson"
        stand.Parent = camera 
        local mainPart = nil
        ignoredParts = {}
        for _, part in ipairs(stand:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide, part.CanTouch, part.CanQuery = false, false, false
                if part.Name == "HumanoidRootPart" or part.Name:lower():find("hitbox") or part.Transparency >= 0.5 then
                    part.Transparency = 1 ignoredParts[part] = true
                end
                if not mainPart and not ignoredParts[part] then mainPart = part end
                part.Anchored, part.Massless = true, true
                if not ignoredParts[part] then part.Transparency = 1 end
                if part ~= mainPart then
                    local weld = Instance.new("WeldConstraint", part)
                    weld.Part0, weld.Part1 = part, mainPart
                    part.Anchored = false
                end
            end
        end
        stand.PrimaryPart = mainPart
        ApplyAura(character, "PlayerAura")
        ApplyAura(stand, "StandAura")
    end

    CreateStand()

    -------------------------------------------------------------------
    -- 3. FIXED DRAGGABLE UI
    -------------------------------------------------------------------
    local screenGui = Instance.new("ScreenGui", player:WaitForChild("PlayerGui"))
    screenGui.Name = "KC_FIXED_GUI"
    screenGui.ResetOnSpawn = true

    local imgBtn = Instance.new("ImageButton", screenGui)
    imgBtn.Size = UDim2.new(0, 85, 0, 85)
    imgBtn.Position = UDim2.new(0.5, -42, 0.8, 0)
    imgBtn.Image = imageAsset
    imgBtn.BackgroundTransparency = 1

    local dragging = false
    local dragInput, dragStart, startPos

    local function update(input)
        local delta = input.Position - dragStart
        imgBtn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end

    imgBtn.InputBegan:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
            dragging = true
            dragStart = input.Position
            startPos = imgBtn.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    imgBtn.InputChanged:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            update(input)
        end
    end)

    -- THE SUMMON LOGIC
    imgBtn.MouseButton1Click:Connect(function()
        if not isSummoned then
            summonSound:Play()
            task.wait(0.093) 
            
            isSummoned = true
            imgBtn.ImageColor3 = Color3.fromRGB(255, 100, 100)
            for _, p in ipairs(auraParticles) do p.Enabled = true end
            
            if not isFirstSummonThisLife then
                task.delay(1.32, function() 
                    if isSummoned then summonSound:Stop() end 
                end)
            else
                isFirstSummonThisLife = false
            end
        else
            isSummoned = false
            imgBtn.ImageColor3 = Color3.new(1, 1, 1)
            for _, p in ipairs(auraParticles) do p.Enabled = false end
            summonSound:Stop()
        end
    end)

    -------------------------------------------------------------------
    -- 4. RENDER LOOP
    -------------------------------------------------------------------
    local connection
    connection = RunService.RenderStepped:Connect(function()
        if not character or not character.Parent or humanoid.Health <= 0 then
            if stand then stand:Destroy() end
            connection:Disconnect()
            screenGui:Destroy()
            return 
        end

        local targetAlpha = isSummoned and 0 or 1
        local targetOffset = isSummoned and Vector3.new(0, 1.8, 2.5) or Vector3.new(0, 0, 0)
        
        currentTransparency = math.lerp(currentTransparency, targetAlpha, 0.35)
        lerpPos = lerpPos:Lerp(targetOffset, 0.25)
        
        local hover = math.sin(tick() * 2) * 0.4
        local finalCFrame = rootPart.CFrame * CFrame.new(lerpPos + Vector3.new(0, hover, 0)) * CFrame.Angles(0, math.rad(180), 0)
        
        if stand and stand.PrimaryPart then
            stand:PivotTo(finalCFrame)
            for _, item in ipairs(stand:GetDescendants()) do
                if not ignoredParts[item] and not item:IsDescendantOf(stand:FindFirstChild("StandAura")) then
                    if item:IsA("BasePart") or item:IsA("Decal") then
                        item.Transparency = currentTransparency
                    end
                end
            end
        end
    end)
end

player.CharacterAdded:Connect(InitializeKC)
if player.Character then InitializeKC(player.Character) end
