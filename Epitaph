-- REPAIRED CLEANER: PRESERVES MOTOR6D JOINTS FOR ANIMATION
-----------------------------------------------------------
local function styleModelAsNeon(model)
    local hum = model:FindFirstChildOfClass("Humanoid")
    
    for _, item in ipairs(model:GetDescendants()) do
        local itemName = item.Name:lower()
        -- CRITICAL FILTER: Drop tools, hats, particles, and footprint/step parts WITHOUT destroying Motor6Ds
        if item:IsA("Tool") or item:IsA("Accessory") or item:IsA("Hat") or item:IsA("ParticleEmitter") or item:IsA("Beam") or item:IsA("Trail") 
           or item:IsA("Decal") or item:IsA("Texture") or item:IsA("Clothing") or item:IsA("ShirtGraphic")
           or itemName:find("foot") or itemName:find("print") or itemName:find("step") then
            item:Destroy()
        elseif item:IsA("BasePart") or item:IsA("MeshPart") then
            item.CanCollide = false
            item.CanTouch = false
            item.CanQuery = false
            
            if item.Name == "HumanoidRootPart" then
                item.Transparency = 1
                item.Anchored = true
            else
                item.Anchored = false -- MUST BE FALSE FOR ANIMATIONS TO REGISTER TRANSFORM POSITIONS
                item.Transparency = 0.2 
                item.Material = Enum.Material.Neon
                item.Color = Color3.fromRGB(255, 0, 80) -- Matching King Crimson Pink-Red
                if item:IsA("MeshPart") then item.TextureID = "" end
            end
        elseif item:IsA("SpecialMesh") or item:IsA("CharacterMesh") then
            if item:IsA("SpecialMesh") then item.TextureId = "" end
        end
    end
    
    if hum then hum:Destroy() end
end

