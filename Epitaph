local function initializePlayerCache(targetPlayer)
    if trailCache[targetPlayer] or not isActive then return end 
    
    local sourceChar = targetPlayer.Character
    if not sourceChar then return end

    sourceChar.Archivable = true
    
    -- 1. Create the main tracking prediction ghost
    local mainGhost = sourceChar:Clone()
    mainGhost.Name = "MainGhost_" .. targetPlayer.Name
    
    -- Clean out accessories and footprint artifacts safely
    for _, item in ipairs(mainGhost:GetDescendants()) do
        local itemName = item.Name:lower()
        if item:IsA("Tool") or item:IsA("Accessory") or item:IsA("Hat") or item:IsA("Script") or item:IsA("LocalScript") 
           or item:IsA("Sound") or item:IsA("BillboardGui") or item:IsA("ParticleEmitter") or item:IsA("Decal") or item:IsA("Texture")
           or itemName:find("foot") or itemName:find("print") or itemName:find("step") then
            item:Destroy()
        end
    end

    local mainHum = mainGhost:FindFirstChildOfClass("Humanoid")
    local mainAnimator = nil
    if mainHum then
        mainHum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
        mainHum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
        mainHum.BreakJointsOnDeath = false
        mainAnimator = mainHum:FindFirstChildOfClass("Animator") or Instance.new("Animator", mainHum)
    end
    
    -- Style main ghost limbs safely without locking joints
    for _, item in ipairs(mainGhost:GetDescendants()) do
        if item:IsA("BasePart") or item:IsA("MeshPart") then
            item.CanCollide = false
            item.CanTouch = false
            item.CanQuery = false
            if item.Name ~= "HumanoidRootPart" then
                item.Anchored = false -- Unanchored so Motor6D can manipulate transformations
                item.Transparency = 0.2
                item.Material = Enum.Material.Neon
                item.Color = Color3.fromRGB(255, 0, 80)
                if item:IsA("MeshPart") then item.TextureID = "" end
            else
                item.Anchored = true -- Keep the Root Part anchored for Pivot stabilization
                item.Transparency = 1
            end
        elseif item:IsA("SpecialMesh") or item:IsA("CharacterMesh") then
            if item:IsA("SpecialMesh") then item.TextureId = "" end
        end
    end
    
    mainGhost.PrimaryPart = mainGhost:FindFirstChild("HumanoidRootPart")
    mainGhost.Parent = worldModel
    ghostCache[targetPlayer] = mainGhost

    -- 2. Pre-instantiate exactly 4 trail models 
    local storageList = {}
    for i = 1, TOTAL_TRAIL_GHOSTS do
        local tClone = sourceChar:Clone()
        tClone.Name = "Trail_" .. targetPlayer.Name .. "_" .. i
        styleModelAsNeon(tClone)
        tClone.PrimaryPart = tClone:FindFirstChild("HumanoidRootPart")
        tClone.Parent = worldModel
        
        tClone:PivotTo(CFrame.new(0, -500, 0))
        table.insert(storageList, tClone)
    end
    
    trailCache[targetPlayer] = storageList
    lastUpdateTime[targetPlayer] = 0
    sourceChar.Archivable = false
end

local function updateLimbPositions(sourceGhost, targetTrailModel)
    local sourceMap = {}
    for _, p in ipairs(sourceGhost:GetDescendants()) do
        if p:IsA("BasePart") then sourceMap[p.Name] = p.CFrame end
    end
    for _, p in ipairs(targetTrailModel:GetDescendants()) do
        if p:IsA("BasePart") then
            local cf = sourceMap[p.Name]
            if cf then p.CFrame = cf end
        end
    end
end

local function updateTrailPositions(targetPlayer, latestGhostCFrame, currentGhost)
    local list = trailCache[targetPlayer]
    if not list then return end
    
    for i = TOTAL_TRAIL_GHOSTS, 2, -1 do
        local leadGhost = list[i - 1]
        local currentTrail = list[i]
        updateLimbPositions(leadGhost, currentTrail)
    end
    
    updateLimbPositions(currentGhost, list[1])
end

local function removePlayerFromCache(targetPlayer)
    if ghostCache[targetPlayer] then ghostCache[targetPlayer]:Destroy() ghostCache[targetPlayer] = nil end
    if trailCache[targetPlayer] then
        for _, model in ipairs(trailCache[targetPlayer]) do
            if model then model:Destroy() end
        end
        trailCache[targetPlayer] = nil
    end
    lastUpdateTime[targetPlayer] = nil
end

local function clearAllGhosts()
    worldModel:ClearAllChildren()
    table.clear(ghostCache)
    table.clear(trailCache)
    table.clear(lastUpdateTime)
end

