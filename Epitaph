-- FIX: RE-ENGINEERED ROBUST ANIMATION SYNCHRONIZATION
-----------------------------------------------------------
local function syncAnimations(realHum, fakeHum)
    if not realHum or not fakeHum then return end  
    local fakeAnimator = fakeHum:FindFirstChildOfClass("Animator") or Instance.new("Animator", fakeHum)
    local realTracks = realHum:GetPlayingAnimationTracks()
    local realMap = {}
    
    for _, track in ipairs(realTracks) do 
        if track.Animation and track.Animation.AnimationId ~= "" then 
            realMap[track.Animation.AnimationId] = track 
        end 
    end  
    
    -- Stop track if it's no longer playing on real player
    for _, fTrack in ipairs(fakeAnimator:GetPlayingAnimationTracks()) do
        local id = fTrack.Animation and fTrack.Animation.AnimationId
        if id and not realMap[id] then 
            fTrack:Stop(0.1) 
        end
    end  
    
    -- Mirror or play matching active animations
    for id, track in pairs(realMap) do
        local activeTrack = nil  
        for _, fTrack in ipairs(fakeAnimator:GetPlayingAnimationTracks()) do
            if fTrack.Animation and fTrack.Animation.AnimationId == id then
                activeTrack = fTrack
                break
            end
        end  
        
        if activeTrack then
            activeTrack:AdjustSpeed(track.Speed)
            -- Prevent snapping back and forth by checking threshold variance
            if math.abs(activeTrack.TimePosition - track.TimePosition) > 0.05 then
                activeTrack.TimePosition = track.TimePosition
            end
        else
            local anim = Instance.new("Animation")
            anim.AnimationId = id  
            local success, newTrack = pcall(function() return fakeAnimator:LoadAnimation(anim) end)
            if success and newTrack then
                newTrack.Priority = track.Priority
                newTrack:Play(0.1)
                newTrack:AdjustSpeed(track.Speed)
                newTrack.TimePosition = track.TimePosition
            end
        end
    end  
end

