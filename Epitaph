local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer

-- Character variables (Auto-updating on spawn)
local character, rootPart, humanoid

-- Configuration
local DETECTION_RADIUS = 50
local DODGE_DISTANCE = 14
local MIN_SPEED = 12 
local ANIM_ID = "rbxassetid://119594034834137"
local SOUND_ID = "rbxassetid://123891403807633"
local IMAGE_URL = "https://raw.githubusercontent.com/alexanderhensworth-dev/King-crimson-/main/1_20260503_005629_0000-removebg-preview.png"
local FILE_NAME = "KingCrimsonIcon.png"

-- State
local isActive = false
local currentTrack = nil
local posHistory = {}
local lastDodgeObject = nil

-----------------------------------------------------------
-- CHARACTER REFRESH SYSTEM
-----------------------------------------------------------
local function updateCharacter(newCharacter)
    character = newCharacter
    rootPart = character:WaitForChild("HumanoidRootPart", 5)
    humanoid = character:WaitForChild("Humanoid", 5)
    
    humanoid.Died:Connect(function()
        rootPart = nil
        humanoid = nil
    end)
end

player.CharacterAdded:Connect(updateCharacter)
if player.Character then updateCharacter(player.Character) end

-----------------------------------------------------------
-- GUI & ASSET SETUP
-----------------------------------------------------------
local success, content = pcall(function() return game:HttpGet(IMAGE_URL) end)
if success then 
    writefile(FILE_NAME, content) 
end

local screenGui = Instance.new("ScreenGui", player:WaitForChild("PlayerGui"))
screenGui.Name = "KingCrimsonDodge"
screenGui.ResetOnSpawn = false 

local imageButton = Instance.new("ImageButton", screenGui)
imageButton.Size = UDim2.new(0, 80, 0, 80)
imageButton.Position = UDim2.new(0.5, -40, 0.8, 0)
imageButton.BackgroundTransparency = 1
imageButton.Image = getcustomasset(FILE_NAME)

local uiCorner = Instance.new("UICorner", imageButton)
uiCorner.CornerRadius = UDim.new(1, 0)

-- Draggable Logic
local dragging, dragInput, dragStart, startPos
local function updateDrag(input)
    local delta = input.Position - dragStart
    imageButton.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
end

imageButton.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging, dragStart, startPos = true, input.Position, imageButton.Position
        input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then dragging = false end end)
    end
end)

imageButton.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then updateDrag(input) end
end)

-- Toggle Logic (10 Second Activation)
imageButton.MouseButton1Click:Connect(function()
    if not isActive then
        isActive = true
        imageButton.ImageColor3 = Color3.fromRGB(255, 100, 100)
        task.wait(10)
        isActive = false
        imageButton.ImageColor3 = Color3.fromRGB(255, 255, 255)
    end
end)

-----------------------------------------------------------
-- VISUALS & SOUND
-----------------------------------------------------------
local function playDodgeSound()
    if not rootPart then return end
    local sound = Instance.new("Sound", rootPart)
    sound.SoundId = SOUND_ID
    sound.Volume = 1
    sound:Play()
    sound.Ended:Connect(function() sound:Destroy() end)
    task.delay(5, function() if sound then sound:Destroy() end end)
end

local function createAfterImage()
    if not character then return end
    local folder = Instance.new("Folder", workspace)
    folder.Name = "DodgeGhost"
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") and part.Transparency < 1 and part.Name ~= "HumanoidRootPart" then
            local ghost = Instance.new("Part")
            ghost.Size, ghost.CFrame, ghost.Anchored, ghost.CanCollide = part.Size, part.CFrame, true, false
            ghost.Material, ghost.Color, ghost.Parent = Enum.Material.ForceField, Color3.fromRGB(255, 0, 0), folder
            local m = part:FindFirstChildOfClass("SpecialMesh") or part:FindFirstChildOfClass("Mesh")
            if m then m:Clone().Parent = ghost end
            TweenService:Create(ghost, TweenInfo.new(0.5), {Transparency = 1}):Play()
        end
    end
    task.delay(0.5, function() folder:Destroy() end)
end

local function playDodgeAnim(side)
    if not humanoid then return end
    if currentTrack then currentTrack:Stop(0) end
    local anim = Instance.new("Animation")
    anim.AnimationId = ANIM_ID
    local success, track = pcall(function() return humanoid:LoadAnimation(anim) end)
    if success and track then
        currentTrack = track
        track.Priority = Enum.AnimationPriority.Action
        track:Play()
        track.TimePosition = (side == -1) and 0.45 or 0.7
        task.delay(0.35, function() if currentTrack == track then track:Stop(0.1) end end)
    end
end

-----------------------------------------------------------
-- SMART-RANDOM PATHFINDING
-----------------------------------------------------------
local function getBestDodgeDirection(bulletVel, bulletPos)
    local bulletDir = bulletVel.Unit
    local up = Vector3.new(0, 1, 0)
    local right = bulletDir:Cross(up).Unit
    if right.Magnitude < 0.01 then right = Vector3.new(1, 0, 0) end
    
    local left = -right
    local forward = rootPart.CFrame.LookVector
    
    local directions = {
        {vec = left, side = -1},
        {vec = right, side = 1},
        {vec = forward, side = 0}
    }
    
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {character, workspace:FindFirstChild("KingCrimson"), workspace:FindFirstChild("StandAura")}
    
    local validOptions = {}

    for _, data in ipairs(directions) do
        local ray = workspace:Raycast(rootPart.Position, data.vec * DODGE_DISTANCE, params)
        local space = ray and (ray.Position - rootPart.Position).Magnitude or DODGE_DISTANCE
        
        local potentialPos = rootPart.Position + (data.vec * (space - 1))
        local rel = potentialPos - bulletPos
        local proj = rel:Dot(bulletDir)
        local pathPoint = bulletPos + (bulletDir * proj)
        local safetyMargin = (potentialPos - pathPoint).Magnitude

        if safetyMargin > 6 and space > 10 then
            table.insert(validOptions, {vec = data.vec, side = data.side, dist = space})
        end
    end
    
    if #validOptions > 0 then
        local choice = validOptions[math.random(1, #validOptions)]
        return choice.vec, choice.side, math.max(4, choice.dist - 2)
    end
    
    return right, 1, 6 
end

-----------------------------------------------------------
-- MAIN HEARTBEAT ENGINE (ANTI-LIMB VERSION)
-----------------------------------------------------------
RunService.Heartbeat:Connect(function(dt)
    if not isActive or not rootPart or not humanoid or humanoid.Health <= 0 then return end
    local myPos = rootPart.Position

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and not obj:IsDescendantOf(character) then
            
            -- IGNORE FILTER (Stand & Aura)
            if obj.Name == "StandAura" or obj.Name == "KingCrimson" or 
               obj:FindFirstAncestor("StandAura") or obj:FindFirstAncestor("KingCrimson") then
                continue
            end

            -- ANTI-LIMB FILTER: Ignore parts belonging to players
            local model = obj:FindFirstAncestorOfClass("Model")
            if model and model:FindFirstChildOfClass("Humanoid") then
                continue
            end

            local dist = (myPos - obj.Position).Magnitude
            if dist < DETECTION_RADIUS then
                local bv = obj:FindFirstChildOfClass("BodyVelocity") or obj:FindFirstChildOfClass("LinearVelocity")
                local vel = bv and (bv:IsA("BodyVelocity") and bv.Velocity or bv.VectorVelocity) or obj.Velocity
                
                if vel.Magnitude < 0.1 then
                    local last = posHistory[obj] or obj.Position
                    posHistory[obj] = obj.Position
                    vel = (obj.Position - last) / dt
                end

                if vel.Magnitude > MIN_SPEED and obj ~= lastDodgeObject then
                    local relPos = myPos - obj.Position
                    local projection = relPos:Dot(vel.Unit)
                    
                    if projection > 0 then
                        local pathPoint = obj.Position + (vel.Unit * projection)
                        if (myPos - pathPoint).Magnitude < 8 then
                            
                            lastDodgeObject = obj
                            local dodgeVec, side, moveDist = getBestDodgeDirection(vel, obj.Position)
                            
                            task.spawn(playDodgeSound)
                            task.spawn(createAfterImage)
                            task.spawn(playDodgeAnim, side)
                            
                            rootPart.CFrame = rootPart.CFrame + (dodgeVec * moveDist)

                            task.delay(0.15, function() 
                                if lastDodgeObject == obj then lastDodgeObject = nil end 
                            end)
                            break
                        end
                    end
                end
            end
        end
    end
end)

-- Memory Cleanup
task.spawn(function()
    while task.wait(5) do
        for obj in pairs(posHistory) do if not obj or not obj.Parent then posHistory[obj] = nil end end
    end
end)
