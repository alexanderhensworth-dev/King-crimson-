-----------------------------------------------------------
-- EPITAPH ANIMATION SYNC
-----------------------------------------------------------
local function syncAnimations(sourceChar, ghostChar)
    local sourceHum = sourceChar:FindFirstChildOfClass("Humanoid")
    local ghostHum = ghostChar:FindFirstChildOfClass("Humanoid")
    if not sourceHum or not ghostHum then return end

    local sourceAnimator = sourceHum:FindFirstChildOfClass("Animator")
    local ghostAnimator = ghostHum:FindFirstChildOfClass("Animator") or Instance.new("Animator", ghostHum)
    if not sourceAnimator then return end

    local sourceTracks = sourceAnimator:GetPlayingAnimationTracks()
    local ghostTracks = ghostAnimator:GetPlayingAnimationTracks()

    -- Stop ghost tracks no longer on source
    for _, gTrack in ipairs(ghostTracks) do
        local isPlaying = false
        for _, sTrack in ipairs(sourceTracks) do
            if sTrack.Animation.AnimationId == gTrack.Animation.AnimationId then
                isPlaying = true
                break
            end
        end
        if not isPlaying then gTrack:Stop(0.1) end
    end

    -- Play/Sync tracks
    for _, sTrack in ipairs(sourceTracks) do
        local gTrack
        for _, t in ipairs(ghostTracks) do
            if t.Animation.AnimationId == sTrack.Animation.AnimationId then
                gTrack = t
                break
            end
        end

        if not gTrack then
            gTrack = ghostAnimator:LoadAnimation(sTrack.Animation)
            gTrack:Play(0.1)
        end

        gTrack.TimePosition = sTrack.TimePosition
        gTrack:AdjustWeight(sTrack.WeightCurrent > 0 and sTrack.WeightCurrent or 1)
        gTrack:AdjustSpeed(sTrack.Speed)
    end
end

-----------------------------------------------------------
-- GHOST CREATION & CLEANUP
-----------------------------------------------------------
local function createEpitaphGhost(targetPlayer)
    if ghostCache[targetPlayer] then return ghostCache[targetPlayer] end
    
    local sourceChar = targetPlayer.Character
    if not sourceChar then return nil end

    sourceChar.Archivable = true
    local ghost = sourceChar:Clone()
    sourceChar.Archivable = false
    
    ghost.Name = "" 
    
    local hum = ghost:FindFirstChildOfClass("Humanoid")
    if hum then 
        hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
        hum.PlatformStand = true 
    end

    local highlight = Instance.new("Highlight", ghost)
    highlight.FillColor = Color3.fromRGB(255, 0, 80)
    highlight.FillTransparency = 0.4

    for _, item in ipairs(ghost:GetDescendants()) do
        if item:IsA("LuaSourceContainer") or item:IsA("Sound") or item:IsA("BillboardGui") then
            item:Destroy()
        elseif item:IsA("BasePart") then
            if item.Name == "HumanoidRootPart" then
                item.Transparency = 1
                item.Anchored = true 
            else
                item.Transparency = 0.7
                item.Material = Enum.Material.Neon
                item.Anchored = false 
            end
            item.CanCollide = false
            item.CanTouch = false
            item.CanQuery = false
        end
    end
    
    ghost.Parent = workspace
    ghostCache[targetPlayer] = ghost
    return ghost
end

local function clearAllGhosts()
    for p, g in pairs(ghostCache) do
        if g then g:Destroy() end
        ghostCache[p] = nil
    end
end

-----------------------------------------------------------
-- OPTIMIZED IGNORE LIST (THE LAG KILLER)
-----------------------------------------------------------
local function updateIgnoreList()
    local newList = {player.Character}
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then
            table.insert(newList, p.Character)
        end
    end
    local sc = workspace:FindFirstChild("KingCrimson")
    if sc then table.insert(newList, sc) end
    ignoreList = newList
end

Players.PlayerAdded:Connect(function(p) p.CharacterAdded:Connect(updateIgnoreList) end)
Players.PlayerRemoving:Connect(function(p)
    if ghostCache[p] then ghostCache[p]:Destroy() ghostCache[p] = nil end
    updateIgnoreList()
end)
task.spawn(function() while task.wait(5) do updateIgnoreList() end end)

