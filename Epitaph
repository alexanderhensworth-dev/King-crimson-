local function playDodgeSound()
    if not rootPart then return end
    local sound = Instance.new("Sound", rootPart)
    sound.SoundId = SOUND_ID
    sound.Volume = 1
    sound:Play()
    sound.Ended:Connect(function() sound:Destroy() end)
end

local function createAfterImage()
    if not character then return end
    local folder = Instance.new("Folder", workspace)
    folder.Name = "DodgeGhost"
    for _, part in ipairs(character:GetDescendants()) do
        local itemName = part.Name:lower()
        if part:IsA("BasePart") and part.Transparency < 1 and part.Name ~= "HumanoidRootPart" 
           and not part:IsDescendantOf(character:FindFirstChildOfClass("Tool") or folder)
           and not (itemName:find("foot") or itemName:find("print") or itemName:find("step")) then
            local ghost = Instance.new("Part")
            ghost.Size, ghost.CFrame, ghost.Anchored, ghost.CanCollide = part.Size, part.CFrame, true, false
            ghost.Material, ghost.Color, ghost.Parent = Enum.Material.ForceField, Color3.fromRGB(255, 0, 0), folder
            local m = part:FindFirstChildOfClass("SpecialMesh") or part:FindFirstChildOfClass("Mesh")
            if m then m:Clone().Parent = ghost end
            TweenService:Create(ghost, TweenInfo.new(0.5), {Transparency = 1}):Play()
        end
    end
    task.delay(0.5, function() folder:Destroy() end)
end

local function playDodgeAnim(side)
    if not humanoid then return end
    if currentTrack then currentTrack:Stop(0) end
    local anim = Instance.new("Animation")
    anim.AnimationId = ANIM_ID
    local success, track = pcall(function() return humanoid:LoadAnimation(anim) end)
    if success and track then
        currentTrack = track
        track.Priority = Enum.AnimationPriority.Action
        track:Play()
        track.TimePosition = (side == -1) and 0.45 or 0.7
        task.delay(0.35, function() if currentTrack == track then track:Stop(0.1) end end)
    end
end

local function getBestDodgeDirection(bulletVel, bulletPos)
    local bulletDir = bulletVel.Unit
    local up = Vector3.new(0, 1, 0)
    local right = bulletDir:Cross(up).Unit
    if right.Magnitude < 0.01 then right = Vector3.new(1, 0, 0) end
    local left = -right
    local forward = rootPart.CFrame.LookVector
    
    local directions = { {vec = left, side = -1}, {vec = right, side = 1}, {vec = forward, side = 0} }
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = ignoreList
    
    local validOptions = {}
    for _, data in ipairs(directions) do
        local ray = workspace:Raycast(rootPart.Position, data.vec * DODGE_DISTANCE, params)
        local space = ray and (ray.Position - rootPart.Position).Magnitude or DODGE_DISTANCE
        local potentialPos = rootPart.Position + (data.vec * (space - 1))
        local rel = potentialPos - bulletPos
        local projection = rel:Dot(bulletDir)
        local pathPoint = bulletPos + (bulletDir * projection)
        local safetyMargin = (potentialPos - pathPoint).Magnitude

        if safetyMargin > 6 and space > 8 then table.insert(validOptions, {vec = data.vec, side = data.side, dist = space}) end
    end
    
    if #validOptions > 0 then
        local choice = validOptions[math.random(1, #validOptions)]
        return choice.vec, choice.side, math.max(4, choice.dist - 2)
    end
    return right, 1, 6 
end

-----------------------------------------------------------
-- CORE HIGH-PERFORMANCE OPERATIONAL LOOP
-----------------------------------------------------------
RunService.Heartbeat:Connect(function(dt)
    if not rootPart or not humanoid or humanoid.Health <= 0 then return end
    local myPos = rootPart.Position

    -- 1. FIXED PREDICTION AND TRAIL
    if isActive then
        vCam.CFrame = CFrame.new(cam.CFrame.Position) * cam.CFrame.Rotation
        vCam.FieldOfView = cam.FieldOfView

        for _, otherPlayer in ipairs(Players:GetPlayers()) do
            if otherPlayer.Character and otherPlayer.Character:FindFirstChild("HumanoidRootPart") then
                if not ghostCache[otherPlayer] or not trailCache[otherPlayer] then
                    initializePlayerCache(otherPlayer)
                end
                
                local ghost = ghostCache[otherPlayer]
                local targetRP = otherPlayer.Character.HumanoidRootPart
                
                if ghost and ghost.PrimaryPart then
                    local targetOffset = (otherPlayer == player) and Vector3.new(0, 0, 0) or (targetRP.AssemblyLinearVelocity * PREDICTION_TIME)
                    local rawFuturePos = targetRP.Position + targetOffset
                    
                    local rayParams = RaycastParams.new()
                    rayParams.FilterType = Enum.RaycastFilterType.Exclude
                    rayParams.FilterDescendantsInstances = ignoreList
                    
                    local floorRay = workspace:Raycast(rawFuturePos + Vector3.new(0, 3, 0), Vector3.new(0, -15, 0), rayParams)
                    local correctedPos = rawFuturePos
                    
                    if floorRay then
                        local floorY = floorRay.Position.Y + (targetRP.Size.Y / 2) + 1.5
                        if correctedPos.Y < floorY then correctedPos = Vector3.new(correctedPos.X, floorY, correctedPos.Z) end
                    end
                    
                    local targetCFrame = CFrame.new(correctedPos) * targetRP.CFrame.Rotation
                    local smoothlyBlendedCFrame = ghost:GetPivot():Lerp(targetCFrame, LERP_SMOOTHNESS)
                    ghost:PivotTo(smoothlyBlendedCFrame)
                    
                    local targetHum = otherPlayer.Character:FindFirstChildOfClass("Humanoid")
                    local ghostHum = ghost:FindFirstChildOfClass("Humanoid")
                    if targetHum and ghostHum then syncAnimations(targetHum, ghostHum) end
                    
                    local currentTime = os.clock()
                    if currentTime - lastUpdateTime[otherPlayer] >= UPDATE_TICK_RATE then
                        updateTrailPositions(otherPlayer, smoothlyBlendedCFrame, ghost)
                        lastUpdateTime[otherPlayer] = currentTime
                    end
                end
            else
                removePlayerFromCache(otherPlayer)
            end
        end
    end

    -- 2. HIGH-PERFORMANCE REGION3 PROJECTILE SCANNING
    local nearbyParts = workspace:FindPartsInRegion3WithIgnoreList(
        Region3.new(myPos - Vector3.new(DETECTION_RADIUS, DETECTION_RADIUS, DETECTION_RADIUS), myPos + Vector3.new(DETECTION_RADIUS, DETECTION_RADIUS, DETECTION_RADIUS)),
        ignoreList,
        100
    )

    for _, obj in ipairs(nearbyParts) do
        if obj:IsA("BasePart") and not obj.Anchored then
            local dist = (myPos - obj.Position).Magnitude
            if dist < DETECTION_RADIUS and obj ~= lastDodgeObject then
                local bv = obj:FindFirstChildOfClass("BodyVelocity") or obj:FindFirstChildOfClass("LinearVelocity")
                local vel = bv and (bv:IsA("BodyVelocity") and bv.Velocity or bv.VectorVelocity) or obj.Velocity
                
                if vel.Magnitude < 0.1 then
                    local last = posHistory[obj] or obj.Position
                    posHistory[obj] = obj.Position
                    vel = (obj.Position - last) / dt
                end

                if vel.Magnitude > MIN_SPEED then
                    local relPos = myPos - obj.Position
                    local projection = relPos:Dot(vel.Unit)
                    
                    if projection > 0 then
                        local pathPoint = obj.Position + (vel.Unit * projection)
                        if (myPos - pathPoint).Magnitude < 7 then
                            lastDodgeObject = obj
                            local dodgeVec, side, moveDist = getBestDodgeDirection(vel, obj.Position)
                            
                            task.spawn(playDodgeSound)
                            task.spawn(createAfterImage)
                            task.spawn(playDodgeAnim, side)
                            
                            rootPart.CFrame = rootPart.CFrame + (dodgeVec * moveDist)

                            task.delay(0.2, function() if lastDodgeObject == obj then lastDodgeObject = nil end end)
                            break
                        end
                    end
                end
            end
        end
    end
end)

task.spawn(function()
    while task.wait(5) do
        for obj in pairs(posHistory) do if not obj or not obj.Parent then posHistory[obj] = nil end end
    end
end)
