    local galaxyUrl = "https://raw.githubusercontent.com/alexanderhensworth-dev/King-crimson-/main/597214bd935bf7298630048c50258295.1000x472x1.jpg"
    local galaxyFile = "galaxy.jpg"
    if not isfile(galaxyFile) then writefile(galaxyFile, game:HttpGet(galaxyUrl)) end
    local galaxyTexture = getcustomasset(galaxyFile)

    local maskH = Instance.new("Frame", gui)
    maskH.AnchorPoint, maskH.Position, maskH.Size, maskH.BackgroundTransparency, maskH.ClipsDescendants, maskH.ZIndex = Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.5), UDim2.fromOffset(0, 0), 1, true, 1

    local bgH = Instance.new("ImageLabel", maskH)
    bgH.AnchorPoint, bgH.Position, bgH.Size, bgH.BackgroundTransparency, bgH.Image, bgH.ScaleType, bgH.ZIndex = Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.5), UDim2.fromOffset(screenX, screenY), 1, galaxyTexture, Enum.ScaleType.Stretch, 1

    local viewportH = Instance.new("ViewportFrame", maskH)
    viewportH.AnchorPoint, viewportH.Position, viewportH.Size, viewportH.BackgroundTransparency, viewportH.ZIndex, viewportH.Ambient, viewportH.LightColor = Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.5), UDim2.fromOffset(screenX, screenY), 1, 2, Color3.fromRGB(40, 0, 60), Color3.fromRGB(120, 60, 180)

    local maskV = Instance.new("Frame", gui)
    maskV.AnchorPoint, maskV.Position, maskV.Size, maskV.BackgroundTransparency, maskV.ClipsDescendants, maskV.ZIndex = Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.5), UDim2.fromOffset(0, 0), 1, true, 1

    local bgV = Instance.new("ImageLabel", maskV)
    bgV.AnchorPoint, bgV.Position, bgV.Size, bgV.BackgroundTransparency, bgV.Image, bgV.ScaleType, bgV.ZIndex = Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.5), UDim2.fromOffset(screenX, screenY), 1, galaxyTexture, Enum.ScaleType.Stretch, 1

    local viewportV = Instance.new("ViewportFrame", maskV)
    viewportV.AnchorPoint, viewportV.Position, viewportV.Size, viewportV.BackgroundTransparency, viewportV.ZIndex, viewportV.Ambient, viewportV.LightColor = Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.5), UDim2.fromOffset(screenX, screenY), 1, 2, Color3.fromRGB(40, 0, 60), Color3.fromRGB(120, 60, 180)

    local world = Instance.new("WorldModel", viewportH)
    local vcam = Instance.new("Camera", viewportH)
    viewportH.CurrentCamera = vcam

    local worldV = Instance.new("WorldModel", viewportV)
    local vcamV = Instance.new("Camera", viewportV)
    viewportV.CurrentCamera = vcamV

    local cc = Instance.new("ColorCorrectionEffect", viewportH)
    cc.Brightness, cc.Contrast, cc.Saturation, cc.TintColor = -0.25, 0.45, -0.65, Color3.fromRGB(180, 120, 255)

    local ccV = Instance.new("ColorCorrectionEffect", viewportV)
    ccV.Brightness, ccV.Contrast, ccV.Saturation, ccV.TintColor = -0.25, 0.45, -0.65, Color3.fromRGB(180, 120, 255)

    local function syncAnimations(realHum, fakeHum)
        if not realHum or not fakeHum then return end
        local fakeAnimator = fakeHum:FindFirstChildOfClass("Animator") or Instance.new("Animator", fakeHum)
        local realTracks = realHum:GetPlayingAnimationTracks()
        local realMap = {}
        for _, track in ipairs(realTracks) do
            if track.Animation then realMap[track.Animation.AnimationId] = track end
        end
        local fakeMap = {}
        for _, fTrack in ipairs(fakeAnimator:GetPlayingAnimationTracks()) do
            if fTrack.Animation then fakeMap[fTrack.Animation.AnimationId] = fTrack end
        end
        for id, fTrack in pairs(fakeMap) do
            if not realMap[id] then fTrack:Stop(0.1) end
        end
        for id, track in pairs(realMap) do
            if fakeMap[id] then
                if math.abs(fakeMap[id].Speed - track.Speed) > 0.05 then
                    fakeMap[id]:AdjustSpeed(track.Speed)
                end
            else
                local anim = Instance.new("Animation")
                anim.AnimationId = id
                local newTrack = fakeAnimator:LoadAnimation(anim)
                newTrack:Play(0.1)
                newTrack:AdjustSpeed(track.Speed)
            end
        end
    end

    local function cloneCharacterInto(targetChar, targetWorld)
        if not targetChar or targetChar:IsDescendantOf(targetWorld) then return nil end
        targetChar.Archivable = true
        local model = targetChar:Clone()
        model.Parent = targetWorld
        for _, v in ipairs(model:GetDescendants()) do
            if v:IsA("Script") or v:IsA("LocalScript") then v:Destroy() end
            if v:IsA("BasePart") then v.Anchored, v.CanCollide = false, false end
        end
        local hum = model:FindFirstChildOfClass("Humanoid")
        if hum and not hum:FindFirstChildOfClass("Animator") then Instance.new("Animator", hum) end
        local root = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChildWhichIsA("BasePart")
        model.PrimaryPart = root
        if root then root.Anchored = true end
        return model
    end

    local function syncPivot(fake, realChar)
        if not fake or not realChar then return end
        local realRoot = realChar:FindFirstChild("HumanoidRootPart")
        local fakeRoot = fake:FindFirstChild("HumanoidRootPart")
        if realRoot and fakeRoot then
            fakeRoot.CFrame = realRoot.CFrame
        else
            fake:PivotTo(realChar:GetPivot())
        end
    end

    local fakePlayers, fakeNPCs = {}, {}
    local fakePlayersV, fakeNPCsV = {}, {}

    local startPosPos = currentPivot.Position
    local GRID_SIZE, CELL_SIZE = 400, 80

    -- Batched, fading grid builder — spawns 4 lines per frame, fades each in
    local function buildGridAsync(targetWorld)
        local lines = {}
        for x = -GRID_SIZE, GRID_SIZE, CELL_SIZE do
            table.insert(lines, {axis = "X", val = x})
        end
        for z = -GRID_SIZE, GRID_SIZE, CELL_SIZE do
            table.insert(lines, {axis = "Z", val = z})
        end

        task.spawn(function()
            local ts = game:GetService("TweenService")
            local BATCH = 4
            for i, line in ipairs(lines) do
                local p = Instance.new("Part", targetWorld)
                p.Anchored, p.CanCollide = true, false
                p.Material, p.Color = Enum.Material.Neon, Color3.new(1,1,1)
                p.Transparency = 1 -- start invisible
                if line.axis == "X" then
                    p.Size = Vector3.new(0.05, 0.05, GRID_SIZE * 2)
                    p.CFrame = CFrame.new(startPosPos.X + line.val, startPosPos.Y - 3, startPosPos.Z)
                else
                    p.Size = Vector3.new(GRID_SIZE * 2, 0.05, 0.05)
                    p.CFrame = CFrame.new(startPosPos.X, startPosPos.Y - 3, startPosPos.Z + line.val)
                end
                -- fade in to target transparency
                ts:Create(p, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Transparency = 0.5}):Play()
                if i % BATCH == 0 then
                    task.wait()
                end
            end
        end)
    end

    local rotatingCubes = {}
    local rotatingCubesV = {}

    -- Batched, fading cube builder — spawns 1 cube per frame, edges fade in
    local function buildCubesAsync(targetWorld, cubeTable)
        task.spawn(function()
            local ts = game:GetService("TweenService")
            for i = 1, 20 do
                local cSize, thick = math.random(5, 20), 0.1
                local centerPos = startPosPos + Vector3.new(math.random(-400, 400), math.random(-400, 400), math.random(-400, 400))
                local cubeModel = Instance.new("Model", targetWorld)
                local edges = {
                    {Vector3.new(cSize, thick, thick), Vector3.new(0, cSize/2, cSize/2)},
                    {Vector3.new(cSize, thick, thick), Vector3.new(0, -cSize/2, cSize/2)},
                    {Vector3.new(cSize, thick, thick), Vector3.new(0, cSize/2, -cSize/2)},
                    {Vector3.new(cSize, thick, thick), Vector3.new(0, -cSize/2, -cSize/2)},
                    {Vector3.new(thick, cSize, thick), Vector3.new(cSize/2, 0, cSize/2)},
                    {Vector3.new(thick, cSize, thick), Vector3.new(-cSize/2, 0, cSize/2)},
                    {Vector3.new(thick, cSize, thick), Vector3.new(cSize/2, 0, -cSize/2)},
                    {Vector3.new(thick, cSize, thick), Vector3.new(-cSize/2, 0, -cSize/2)},
                    {Vector3.new(thick, thick, cSize), Vector3.new(cSize/2, cSize/2, 0)},
                    {Vector3.new(thick, thick, cSize), Vector3.new(-cSize/2, cSize/2, 0)},
                    {Vector3.new(thick, thick, cSize), Vector3.new(cSize/2, -cSize/2, 0)},
                    {Vector3.new(thick, thick, cSize), Vector3.new(-cSize/2, -cSize/2, 0)}
                }
                for _, d in ipairs(edges) do
                    local p = Instance.new("Part", cubeModel)
                    p.Size, p.Position, p.Anchored, p.CanCollide = d[1], centerPos + d[2], true, false
                    p.Material, p.Color = Enum.Material.Neon, Color3.new(1,1,1)
                    p.Transparency = 1 -- start invisible
                    ts:Create(p, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Transparency = 0.2}):Play()
                end
                local rotSpeed = Vector3.new(math.random(-10,10)/2000, math.random(-10,10)/2000, math.random(-10,10)/2000)
                table.insert(cubeTable, {model = cubeModel, pos = centerPos, speed = rotSpeed, angle = CFrame.Angles(0,0,0)})
                task.wait() -- yield one frame per cube
            end
        end)
    end

    -- Kick off async spawning for both viewports
    buildGridAsync(world)
    buildGridAsync(worldV)
    buildCubesAsync(world, rotatingCubes)
    buildCubesAsync(worldV, rotatingCubesV)

    local isActive = true
    local ts = game:GetService("TweenService")

    local function endEffect()
        if not isActive then return end
        isActive = false
        timeEraseActive = false
        effectActive = false
        endEffectCallback = nil

        if jumpConnection then jumpConnection:Disconnect(); jumpConnection = nil end
        if infiniteJumpConn then infiniteJumpConn:Disconnect(); infiniteJumpConn = nil end

        if humanoid then
            humanoid.WalkSpeed = origWS
            humanoid.JumpPower = origJP
            humanoid.UseJumpPower = origUJP
        end

        player.DevCameraOcclusionMode = originalOcclusion
        player.CameraMaxZoomDistance = originalMaxZoom

        if currentSeat then currentSeat:Destroy(); currentSeat = nil end

        themeSound:Stop()
        if not endSound.IsLoaded then endSound.Loaded:Wait() end
        endSound:Play()

        local unplusInfo = TweenInfo.new(0.5, Enum.EasingStyle.Cubic, Enum.EasingDirection.In)
        ts:Create(maskH, unplusInfo, {Size = UDim2.fromOffset(diam, 6)}):Play()
        ts:Create(maskV, unplusInfo, {Size = UDim2.fromOffset(6, diam)}):Play()
        task.wait(0.45)

        local closeInfo = TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        ts:Create(maskH, closeInfo, {Size = UDim2.fromOffset(0, 0)}):Play()
        local closeTween = ts:Create(maskV, closeInfo, {Size = UDim2.fromOffset(0, 0)})
        closeTween:Play()
        closeTween.Completed:Wait()

        if gui then gui:Destroy() end
        if permFloor then permFloor:Destroy() end

        task.spawn(function()
            if endSound.IsPlaying then endSound.Ended:Wait() end
            endSound:Destroy()
        end)

        startSound:Destroy()
        themeSound:Destroy()
    end

    endEffectCallback = endEffect

    infiniteJumpConn = uis.JumpRequest:Connect(function()
        if isActive and humanoid then
            humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end)

    if jumpConnection then jumpConnection:Disconnect() end
    jumpCount = 0
    jumpConnection = humanoid.Jumping:Connect(function(isJumping)
        if isJumping and not timeEraseActive then
            jumpCount = jumpCount + 1
            if jumpCount >= 6 then
                if permFloor then permFloor:Destroy() end
                jumpConnection:Disconnect()
            end
        end
    end)

    task.wait(0.2)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character then
            fakePlayers[plr] = cloneCharacterInto(plr.Character, world)
            fakePlayersV[plr] = cloneCharacterInto(plr.Character, worldV)
        end
    end

    for _, v in ipairs(workspace:GetDescendants()) do
        if (v:IsA("Humanoid") and not Players:GetPlayerFromCharacter(v.Parent)) or (v.Name == "KingCrimson" and v:IsA("Model")) then
            local target = v:IsA("Humanoid") and v.Parent or v
            if not target:IsDescendantOf(gui) then
                fakeNPCs[target] = cloneCharacterInto(target, world)
                fakeNPCsV[target] = cloneCharacterInto(target, worldV)
            end
        end
    end

    task.spawn(function()
        if not startSound.IsLoaded then startSound.Loaded:Wait() end
        startSound:Play()

        player.DevCameraOcclusionMode, player.CameraMaxZoomDistance = Enum.DevCameraOcclusionMode.Invisicam, 9999

        if char then
            local savedpos = char:GetPivot()
            char:MoveTo(Vector3.new(0, 5000, 0))
            task.wait(0.1)
            currentSeat = Instance.new("Seat", workspace)
            currentSeat.Transparency, currentSeat.CanCollide, currentSeat.Position = 1, false, Vector3.new(0, 5000, 0)
            local Weld = Instance.new("Weld", currentSeat)
            Weld.Part0, Weld.Part1 = currentSeat, char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
            task.wait(); currentSeat.CFrame = savedpos
        end

        task.wait(0.093)

        maskH.Size = UDim2.fromOffset(0, 0)
        maskV.Size = UDim2.fromOffset(0, 0)
        task.wait(0.01)

        local shootInfo = TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        ts:Create(maskH, shootInfo, {Size = UDim2.fromOffset(diam, 6)}):Play()
        ts:Create(maskV, shootInfo, {Size = UDim2.fromOffset(6, diam)}):Play()
        task.wait(0.3)

        local plusInfo = TweenInfo.new(0.5, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out)
        ts:Create(maskH, plusInfo, {Size = UDim2.fromOffset(diam, screenY * 0.38)}):Play()
        ts:Create(maskV, plusInfo, {Size = UDim2.fromOffset(screenX * 0.38, diam)}):Play()
        task.wait(0.45)

        local fullInfo = TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        ts:Create(maskH, fullInfo, {Size = UDim2.fromOffset(diam, diam)}):Play()
        ts:Create(maskV, fullInfo, {Size = UDim2.fromOffset(diam, diam)}):Play()
        task.wait(0.7)

        if startSound.IsPlaying then startSound.Ended:Wait() end
        if isActive then
            if not themeSound.IsLoaded then themeSound.Loaded:Wait() end
            themeSound:Play()
        end
    end)

    local npcSyncCounter = 0
    local RunService = game:GetService("RunService")
    local renderConn

    renderConn = RunService.RenderStepped:Connect(function()
        if not isActive then renderConn:Disconnect() return end

        npcSyncCounter = npcSyncCounter + 1

        if npcSyncCounter % 6 == 0 and char then
            for _, v in ipairs(char:GetDescendants()) do
                if v:IsA("BasePart") and v.CanCollide then v.CanCollide = false end
            end
        end

        vcam.CFrame, vcam.FieldOfView = cam.CFrame, cam.FieldOfView
        vcamV.CFrame, vcamV.FieldOfView = cam.CFrame, cam.FieldOfView

        for _, c in ipairs(rotatingCubes) do
            c.angle = c.angle * CFrame.Angles(c.speed.X, c.speed.Y, c.speed.Z)
            c.model:PivotTo(CFrame.new(c.pos) * c.angle)
        end
        for _, c in ipairs(rotatingCubesV) do
            c.angle = c.angle * CFrame.Angles(c.speed.X, c.speed.Y, c.speed.Z)
            c.model:PivotTo(CFrame.new(c.pos) * c.angle)
        end

        if fakePlayers[player] then
            syncPivot(fakePlayers[player], char)
            syncAnimations(humanoid, fakePlayers[player]:FindFirstChildOfClass("Humanoid"))
        end
        if fakePlayersV[player] then
            syncPivot(fakePlayersV[player], char)
            syncAnimations(humanoid, fakePlayersV[player]:FindFirstChildOfClass("Humanoid"))
        end

        for otherPlr, fake in pairs(fakePlayers) do
            if otherPlr ~= player and otherPlr.Character then
                syncPivot(fake, otherPlr.Character)
                syncAnimations(otherPlr.Character:FindFirstChildOfClass("Humanoid"), fake:FindFirstChildOfClass("Humanoid"))
            end
        end
        for otherPlr, fake in pairs(fakePlayersV) do
            if otherPlr ~= player and otherPlr.Character then
                syncPivot(fake, otherPlr.Character)
                syncAnimations(otherPlr.Character:FindFirstChildOfClass("Humanoid"), fake:FindFirstChildOfClass("Humanoid"))
            end
        end

        if npcSyncCounter % 4 == 0 then
            for real, model in pairs(fakeNPCs) do
                if real and real.Parent and model then
                    syncPivot(model, real)
                    syncAnimations(real:FindFirstChildOfClass("Humanoid"), model:FindFirstChildOfClass("Humanoid"))
                end
            end
            for real, model in pairs(fakeNPCsV) do
                if real and real.Parent and model then
                    syncPivot(model, real)
                    syncAnimations(real:FindFirstChildOfClass("Humanoid"), model:FindFirstChildOfClass("Humanoid"))
                end
            end
        end
    end)
end)
