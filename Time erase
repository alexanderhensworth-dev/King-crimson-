local Players = game:GetService("Players")  
local RunService = game:GetService("RunService")  
local TweenService = game:GetService("TweenService")  
local Debris = game:GetService("Debris")  
local UserInputService = game:GetService("UserInputService")
local HttpService = game:GetService("HttpService")

local player = Players.LocalPlayer  
local cam = workspace.CurrentCamera  

-- 🔗 FIREBASE CONFIG
local BASE_URL = "https://king-crimson-d4d9b-default-rtdb.firebaseio.com/"
local EVENTS_URL = BASE_URL .. "events.json"

-- 📊 PERSISTENT TRACKING
local jumpCount = 0
local jumpConnection = nil
local toolConnection = nil
local infiniteJumpConn = nil
local timeEraseActive = false

-- 🖼️ IMAGE BUTTON SETUP
local iconUrl = "https://raw.githubusercontent.com/alexanderhensworth-dev/King-crimson-/main/1_20260503_005815_0000-removebg-preview.png"
local iconFile = "kc_icon.png"
if not isfile(iconFile) then writefile(iconFile, game:HttpGet(iconUrl)) end
local iconAsset = getcustomasset(iconFile)

-- 🔘 TOGGLE BUTTON GUI
local mainGui = Instance.new("ScreenGui")
mainGui.Name = "KCToggleGui"
mainGui.ResetOnSpawn = false
mainGui.IgnoreGuiInset = true
mainGui.Parent = player:WaitForChild("PlayerGui")

local activateBtn = Instance.new("ImageButton")
activateBtn.Name = "ActivateButton"
activateBtn.AnchorPoint = Vector2.new(0.5, 0.5)
activateBtn.Position = UDim2.new(0.85, 0, 0.85, 0)
activateBtn.Size = UDim2.new(0, 85, 0, 85)
activateBtn.BackgroundTransparency = 1
activateBtn.Image = iconAsset
activateBtn.Parent = mainGui

-- 🖐️ DRAGGABLE LOGIC
local dragging, dragInput, dragStart, startPos
local function update(input)
    local delta = input.Position - dragStart
    activateBtn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
end

activateBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = activateBtn.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)

activateBtn.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then update(input) end
end)

-- 🎬 THE MAIN SCRIPT
activateBtn.MouseButton1Click:Connect(function()
    if player.PlayerGui:FindFirstChild("GalaxyTransition") then return end

    local char = player.Character
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    local rootPart = char and char:FindFirstChild("HumanoidRootPart")
    
    if not char or not humanoid or not rootPart then return end

    timeEraseActive = true
    local currentSeat = nil

    -- ⚡ SPEED & JUMP BUFFS
    local originalWalkSpeed = humanoid.WalkSpeed
    local originalJumpPower = humanoid.JumpPower
    local originalUseJumpPower = humanoid.UseJumpPower

    humanoid.WalkSpeed = originalWalkSpeed * 1.3
    humanoid.UseJumpPower = true
    humanoid.JumpPower = 70

    -- 📡 1. FIREBASE SENDER & WHITELIST FETCH
    local immuneUsers = {}
    task.spawn(function()
        local pos = rootPart.Position
        local look = rootPart.CFrame.LookVector
        local data = {
            ["user"] = player.Name,
            ["message"] = "Time erase has started.",
            ["position"] = {["x"] = pos.X, ["y"] = pos.Y, ["z"] = pos.Z},
            ["facing"] = {["x"] = look.X, ["y"] = look.Y, ["z"] = look.Z},
            ["time"] = os.time()
        }
        
        pcall(function()
            request({
                Url = EVENTS_URL,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = HttpService:JSONEncode(data)
            })
        end)
        
        local success, response = pcall(function()
            return request({ Url = EVENTS_URL, Method = "GET" })
        end)
        if success and response.Body then
            local allData = HttpService:JSONDecode(response.Body)
            if allData then
                for _, entry in pairs(allData) do
                    if entry.user then immuneUsers[entry.user] = true end
                end
            end
        end
    end)

    -- 🌐 PLATFORM LOGIC
    local oldPlatform = workspace:FindFirstChild("KC_PERMANENT_FLOOR")
    if oldPlatform then oldPlatform:Destroy() end

    local currentPivot = char:GetPivot()
    local permFloor = Instance.new("Part", workspace)
    permFloor.Name = "KC_PERMANENT_FLOOR"
    permFloor.Size = Vector3.new(4000, 1, 4000)
    permFloor.CFrame = CFrame.new(currentPivot.X, currentPivot.Y - 5, currentPivot.Z) 
    permFloor.Transparency, permFloor.Anchored, permFloor.CanCollide = 1, true, true

    local originalOcclusion = player.DevCameraOcclusionMode
    local originalMaxZoom = player.CameraMaxZoomDistance

    -- 🎵 AUDIO
    local audioUrl = "https://raw.githubusercontent.com/alexanderhensworth-dev/King-crimson-/main/YTDown-Shorts-King-Crimson-Times.MP3"
    local audioFile = "kc_time_erase.mp3"
    if not isfile(audioFile) then writefile(audioFile, game:HttpGet(audioUrl)) end
    local audioAsset = getcustomasset(audioFile)
    local sound = Instance.new("Sound", game:GetService("SoundService"))
    sound.SoundId, sound.Volume = audioAsset, 2

    -- GUI SETUP
    local gui = Instance.new("ScreenGui", player:WaitForChild("PlayerGui"))
    gui.IgnoreGuiInset, gui.Name = true, "GalaxyTransition"
    local mask = Instance.new("Frame", gui)
    mask.AnchorPoint, mask.Position, mask.Size = Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.5), UDim2.fromOffset(0, 0) 
    mask.BackgroundColor3, mask.BorderSizePixel, mask.ClipsDescendants = Color3.new(0,0,0), 0, true
    Instance.new("UICorner", mask).CornerRadius = UDim.new(1, 0)

    local viewport = Instance.new("ViewportFrame", mask)
    viewport.Size, viewport.BackgroundTransparency = UDim2.fromScale(1, 1), 1  
    viewport.Ambient, viewport.LightColor = Color3.fromRGB(40, 0, 60), Color3.fromRGB(120, 60, 180)
    local world = Instance.new("WorldModel", viewport)  
    local vcam = Instance.new("Camera", viewport)  
    viewport.CurrentCamera = vcam  
    local cc = Instance.new("ColorCorrectionEffect", viewport)
    cc.Brightness, cc.Contrast, cc.Saturation = -0.25, 0.45, -0.65
    cc.TintColor = Color3.fromRGB(180, 120, 255)

    -- 🌌 GALAXY TEXTURE
    local galaxyUrl = "https://raw.githubusercontent.com/alexanderhensworth-dev/King-crimson-/main/sagdig_opo0431b_web.jpg"
    local galaxyFile = "galaxy.jpg"
    if not isfile(galaxyFile) then writefile(galaxyFile, game:HttpGet(galaxyUrl)) end
    local galaxyTexture = getcustomasset(galaxyFile)
    local SIZE = 800  
    local skyCube = Instance.new("Part", world)  
    skyCube.Size, skyCube.Anchored, skyCube.CanCollide, skyCube.Color = Vector3.new(SIZE, SIZE, SIZE), true, false, Color3.new(0,0,0)  
    for _, face in ipairs(Enum.NormalId:GetEnumItems()) do  
        local decal = Instance.new("Decal", skyCube)  
        decal.Texture, decal.Face = galaxyTexture, face  
    end  

    -- 🔄 HELPERS
    local function syncAnimations(realHum, fakeHum)
        if not realHum or not fakeHum then return end  
        local fakeAnimator = fakeHum:FindFirstChildOfClass("Animator") or Instance.new("Animator", fakeHum)
        local realTracks = realHum:GetPlayingAnimationTracks()
        local realMap = {}
        for _, track in ipairs(realTracks) do if track.Animation then realMap[track.Animation.AnimationId] = track end end  
        for _, fTrack in ipairs(fakeAnimator:GetPlayingAnimationTracks()) do
            local id = fTrack.Animation and fTrack.Animation.AnimationId
            if id and not realMap[id] then fTrack:Stop(0.1) end
        end  
        for id, track in pairs(realMap) do
            local exists = false  
            for _, fTrack in ipairs(fakeAnimator:GetPlayingAnimationTracks()) do
                if fTrack.Animation and fTrack.Animation.AnimationId == id then
                    exists = true; fTrack:AdjustSpeed(track.Speed); break
                end
            end  
            if not exists then
                local anim = Instance.new("Animation")
                anim.AnimationId = id  
                local newTrack = fakeAnimator:LoadAnimation(anim)
                newTrack:Play(0.1); newTrack:AdjustSpeed(track.Speed)
            end
        end  
    end  

    local function cloneCharacter(targetChar)  
        if not targetChar or targetChar:IsDescendantOf(viewport) then return nil end  
        targetChar.Archivable = true  
        local model = targetChar:Clone()
        model.Parent = world
        for _, v in ipairs(model:GetDescendants()) do
            if v:IsA("Script") or v:IsA("LocalScript") then v:Destroy() end
            if v:IsA("BasePart") then v.Anchored, v.CanCollide = false, false end
        end  
        local hum = model:FindFirstChildOfClass("Humanoid")
        if hum and not hum:FindFirstChildOfClass("Animator") then Instance.new("Animator", hum) end
        model.PrimaryPart = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChildWhichIsA("BasePart")
        if model.PrimaryPart then model.PrimaryPart.Anchored = true end
        return model  
    end  

    -- Visual Grid Logic
    local startPosPos = currentPivot.Position
    local GRID_SIZE, CELL_SIZE = 1200, 25
    for x = -GRID_SIZE, GRID_SIZE, CELL_SIZE do
        local p = Instance.new("Part", world)
        p.Anchored, p.CanCollide, p.Size = true, false, Vector3.new(0.05, 0.05, GRID_SIZE * 2)
        p.Material, p.Color, p.Transparency = Enum.Material.Neon, Color3.new(1,1,1), 0.5
        p.CFrame = CFrame.new(startPosPos.X + x, startPosPos.Y - 3, startPosPos.Z)
    end
    for z = -GRID_SIZE, GRID_SIZE, CELL_SIZE do
        local p = Instance.new("Part", world)
        p.Anchored, p.CanCollide, p.Size = true, false, Vector3.new(GRID_SIZE * 2, 0.05, 0.05)
        p.Material, p.Color, p.Transparency = Enum.Material.Neon, Color3.new(1,1,1), 0.5
        p.CFrame = CFrame.new(startPosPos.X, startPosPos.Y - 3, startPosPos.Z + z)
    end

    local rotatingCubes = {}
    for i = 1, 150 do
        local cSize, thick = math.random(5, 20), 0.1
        local centerPos = startPosPos + Vector3.new(math.random(-SIZE/2, SIZE/2), math.random(-SIZE/2, SIZE/2), math.random(-SIZE/2, SIZE/2))
        local cubeModel = Instance.new("Model", world)
        local edges = { {Vector3.new(cSize, thick, thick), Vector3.new(0, cSize/2, cSize/2)}, {Vector3.new(cSize, thick, thick), Vector3.new(0, -cSize/2, cSize/2)}, {Vector3.new(cSize, thick, thick), Vector3.new(0, cSize/2, -cSize/2)}, {Vector3.new(cSize, thick, thick), Vector3.new(0, -cSize/2, -cSize/2)}, {Vector3.new(thick, cSize, thick), Vector3.new(cSize/2, 0, cSize/2)}, {Vector3.new(thick, cSize, thick), Vector3.new(-cSize/2, 0, cSize/2)}, {Vector3.new(thick, cSize, thick), Vector3.new(cSize/2, 0, -cSize/2)}, {Vector3.new(thick, cSize, thick), Vector3.new(-cSize/2, 0, -cSize/2)}, {Vector3.new(thick, thick, cSize), Vector3.new(cSize/2, cSize/2, 0)}, {Vector3.new(thick, thick, cSize), Vector3.new(-cSize/2, cSize/2, 0)}, {Vector3.new(thick, thick, cSize), Vector3.new(cSize/2, -cSize/2, 0)}, {Vector3.new(thick, thick, cSize), Vector3.new(-cSize/2, -cSize/2, 0)} }
        for _, d in ipairs(edges) do
            local p = Instance.new("Part", cubeModel)
            p.Size, p.Position, p.Anchored, p.CanCollide = d[1], centerPos + d[2], true, false
            p.Material, p.Color, p.Transparency = Enum.Material.Neon, Color3.new(1,1,1), 0.2
        end
        local rotSpeed = Vector3.new(math.random(-10, 10)/2000, math.random(-10, 10)/2000, math.random(-10, 10)/2000)
        table.insert(rotatingCubes, {model = cubeModel, pos = centerPos, speed = rotSpeed, angle = CFrame.Angles(0,0,0)})
    end

    -- ❄️ SETUP SCAN
    local isActive = true
    local fakePlayers, fakeNPCs = {}, {}

    -- 🛑 CENTRAL CLEANUP FUNCTION
    local function endEffect()
        if not isActive then return end
        isActive = false
        timeEraseActive = false
        
        -- FIX: Immediately remove seat and return player to game world
        if currentSeat then 
            currentSeat:Destroy() 
            currentSeat = nil
        end

        if toolConnection then toolConnection:Disconnect(); toolConnection = nil end
        if infiniteJumpConn then infiniteJumpConn:Disconnect(); infiniteJumpConn = nil end

        -- Restore stats
        if humanoid then
            humanoid.WalkSpeed = originalWalkSpeed
            humanoid.JumpPower = originalJumpPower
            humanoid.UseJumpPower = originalUseJumpPower
        end
        
        player.DevCameraOcclusionMode = originalOcclusion
        player.CameraMaxZoomDistance = originalMaxZoom
        
        -- Firebase End Signal
        task.spawn(function()
            local endData = { ["user"] = player.Name, ["message"] = "Time erase has ended.", ["time"] = os.time() }
            pcall(function() request({ Url = EVENTS_URL, Method = "POST", Body = HttpService:JSONEncode(endData) }) end)
        end)

        local closeTween = TweenService:Create(mask, TweenInfo.new(0.6, Enum.EasingStyle.Quad), {Size = UDim2.fromOffset(0, 0)})
        closeTween:Play()
        closeTween.Completed:Wait()
        
        if gui then gui:Destroy() end
        activateBtn.Visible = true
        if sound then sound:Stop(); sound:Destroy() end
    end

    -- 🛰️ INFINITE JUMP
    infiniteJumpConn = UserInputService.JumpRequest:Connect(function()
        if isActive and humanoid then
            humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end)

    -- 🛰️ JUMP TRACKER (ONLY OUTSIDE TIME ERASE)
    if jumpConnection then jumpConnection:Disconnect() end
    jumpCount = 0
    jumpConnection = humanoid.Jumping:Connect(function(isJumping)
        if isJumping and not timeEraseActive then
            jumpCount = jumpCount + 1
            if jumpCount >= 6 then
                if permFloor then permFloor:Destroy() end
                jumpConnection:Disconnect()
            end
        end
    end)

    toolConnection = char.ChildAdded:Connect(function(child)
        if child:IsA("Tool") then endEffect() end
    end)

    -- Collect Targets
    task.wait(0.2)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character then fakePlayers[plr] = cloneCharacter(plr.Character) end
    end
    
    for _, v in ipairs(workspace:GetDescendants()) do
        if (v:IsA("Humanoid") and not Players:GetPlayerFromCharacter(v.Parent)) or (v.Name == "KingCrimson" and v:IsA("Model")) then
            local target = v:IsA("Humanoid") and v.Parent or v
            if not target:IsDescendantOf(gui) then
                fakeNPCs[target] = cloneCharacter(target)
            end
        end
    end

    -- 🎬 START SEQUENCE
    local sequenceThread = task.spawn(function()
        if not sound.IsLoaded then sound.Loaded:Wait() end
        local targetDiameter = math.sqrt(cam.ViewportSize.X^2 + cam.ViewportSize.Y^2) * 1.5
        sound:Play()
        activateBtn.Visible = false
        player.DevCameraOcclusionMode, player.CameraMaxZoomDistance = Enum.DevCameraOcclusionMode.Invisicam, 9999

        if char then
            local savedpos = char:GetPivot()
            char:MoveTo(Vector3.new(0, 5000, 0)) 
            task.wait(0.1)
            currentSeat = Instance.new("Seat", workspace)
            currentSeat.Transparency, currentSeat.CanCollide, currentSeat.Position = 1, false, Vector3.new(0, 5000, 0)
            local Weld = Instance.new("Weld", currentSeat)
            Weld.Part0, Weld.Part1 = currentSeat, char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
            task.wait(); currentSeat.CFrame = savedpos
        end

        task.wait(0.093)
        TweenService:Create(mask, TweenInfo.new(1.2, Enum.EasingStyle.Cubic), {Size = UDim2.fromOffset(targetDiameter, targetDiameter)}):Play()

        -- Fixed dynamic wait
        task.wait(sound.TimeLength > 0 and (sound.TimeLength - 1.4) or 5)
        
        endEffect()
    end)

    local renderConn
    renderConn = RunService.RenderStepped:Connect(function()  
        if not isActive then renderConn:Disconnect() return end
        if char then 
            for _, v in ipairs(char:GetDescendants()) do 
                if v:IsA("BasePart") and v.CanCollide then v.CanCollide = false end 
            end 
        end
        vcam.CFrame, vcam.FieldOfView = cam.CFrame, cam.FieldOfView
        skyCube.CFrame = CFrame.new(cam.CFrame.Position)
        for _, c in ipairs(rotatingCubes) do
            c.angle = c.angle * CFrame.Angles(c.speed.X, c.speed.Y, c.speed.Z)
            c.model:PivotTo(CFrame.new(c.pos) * c.angle)
        end
        
        if fakePlayers[player] then 
            fakePlayers[player]:PivotTo(char:GetPivot())
            syncAnimations(humanoid, fakePlayers[player]:FindFirstChildOfClass("Humanoid"))
        end  

        for otherPlr, fake in pairs(fakePlayers) do
            if otherPlr ~= player and otherPlr.Character then
                fake:PivotTo(otherPlr.Character:GetPivot())
                syncAnimations(otherPlr.Character:FindFirstChildOfClass("Humanoid"), fake:FindFirstChildOfClass("Humanoid"))
            end
        end

        for real, model in pairs(fakeNPCs) do
            if real and real.Parent and model then
                local root = real:FindFirstChild("HumanoidRootPart") or real.PrimaryPart
                if root then
                    model:PivotTo(root.CFrame)
                    syncAnimations(real:FindFirstChildOfClass("Humanoid"), model:FindFirstChildOfClass("Humanoid"))
                end
            end
        end
    end)
end)
