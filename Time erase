local Players = game:GetService("Players")  
local player = Players.LocalPlayer  
local cam = workspace.CurrentCamera  

local jumpCount = 0
local jumpConnection
local infiniteJumpConn
local timeEraseActive = false

local btnUrl = "https://raw.githubusercontent.com/alexanderhensworth-dev/King-crimson-/refs/heads/main/Glossy%20button.png"
local btnFile = "NewButtonKC.png"
if not isfile(btnFile) then writefile(btnFile, game:HttpGet(btnUrl)) end
local btnAsset = getcustomasset(btnFile)

local mainGui = Instance.new("ScreenGui")
mainGui.Name = "KCToggleGui"
mainGui.ResetOnSpawn = false
mainGui.IgnoreGuiInset = true
mainGui.Parent = player:WaitForChild("PlayerGui")

local btn = Instance.new("ImageButton")
btn.Name = "ActivateButton"
btn.AnchorPoint = Vector2.new(0.5, 0.5)
btn.Position = UDim2.new(0.85, 0, 0.85, 0)
btn.Size = UDim2.new(0, 85, 0, 85)
btn.BackgroundTransparency = 1
btn.Image = btnAsset
btn.Parent = mainGui

local dragging, dragInput, dragStart, startPos
local uis = game:GetService("UserInputService")

local function update(input)
    local delta = input.Position - dragStart
    btn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
end

btn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = btn.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)

btn.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

uis.InputChanged:Connect(function(input)
    if input == dragInput and dragging then update(input) end
end)

local effectActive = false
local endEffectCallback

btn.MouseButton1Click:Connect(function()
    if effectActive then
        if endEffectCallback then endEffectCallback() end
        return
    end

    if player.PlayerGui:FindFirstChild("GalaxyTransition") then return end

    local char = player.Character
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    local rootPart = char and char:FindFirstChild("HumanoidRootPart")
    if not char or not humanoid or not rootPart then return end

    effectActive = true
    timeEraseActive = true
    local currentSeat

    local origWS = humanoid.WalkSpeed
    local origJP = humanoid.JumpPower
    local origUJP = humanoid.UseJumpPower

    humanoid.WalkSpeed = origWS * 1.3
    humanoid.UseJumpPower = true
    humanoid.JumpPower = 70

    local oldPlatform = workspace:FindFirstChild("KC_PERMANENT_FLOOR")
    if oldPlatform then oldPlatform:Destroy() end

    local currentPivot = char:GetPivot()
    local permFloor = Instance.new("Part", workspace)
    permFloor.Name = "KC_PERMANENT_FLOOR"
    permFloor.Size = Vector3.new(4000, 1, 4000)
    permFloor.CFrame = CFrame.new(currentPivot.X, currentPivot.Y - 5, currentPivot.Z)
    permFloor.Transparency, permFloor.Anchored, permFloor.CanCollide = 1, true, true

    local originalOcclusion = player.DevCameraOcclusionMode
    local originalMaxZoom = player.CameraMaxZoomDistance

    local startAudioUrl = "https://raw.githubusercontent.com/alexanderhensworth-dev/King-crimson-/main/screen-20260606-1119222.mp3"
    local startAudioFile = "kc_start_sfx.mp3"
    if not isfile(startAudioFile) then writefile(startAudioFile, game:HttpGet(startAudioUrl)) end
    local startAudioAsset = getcustomasset(startAudioFile)

    local themeAudioUrl = "https://raw.githubusercontent.com/alexanderhensworth-dev/King-crimson-/main/JOJO%27s%20Bizarre%20Adventure%20Golden%20Wind%20OST%20-%20Un%27altra%20persona%20%28Boss%27s%20theme%29.mp3"
    local themeAudioFile = "kc_theme_sfx.mp3"
    if not isfile(themeAudioFile) then writefile(themeAudioFile, game:HttpGet(themeAudioUrl)) end
    local themeAudioAsset = getcustomasset(themeAudioFile)

    local endAudioUrl = "https://raw.githubusercontent.com/alexanderhensworth-dev/King-crimson-/main/screen-20260606-1119223.mp3"
    local endAudioFile = "kc_end_sfx.mp3"
    if not isfile(endAudioFile) then writefile(endAudioFile, game:HttpGet(endAudioUrl)) end
    local endAudioAsset = getcustomasset(endAudioFile)

    local sServ = game:GetService("SoundService")
    local startSound = Instance.new("Sound", sServ)
    startSound.SoundId = startAudioAsset
    startSound.Volume = 2

    local themeSound = Instance.new("Sound", sServ)
    themeSound.SoundId = themeAudioAsset
    themeSound.Volume = 1.5
