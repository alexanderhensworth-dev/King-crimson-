local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local rootPart = character:WaitForChild("HumanoidRootPart")

-- // Configuration
local DISTANCE = 20
local GHOST_DURATION = 0.35
local COOLDOWN = 2
local canDash = true
local SOUND_ID = "rbxassetid://123891403807633"
local IMAGE_URL = "https://raw.githubusercontent.com/alexanderhensworth-dev/King-crimson-/main/1_20260503_005901_0000-removebg-preview.png"
local VIDEO_URL = "https://raw.githubusercontent.com/alexanderhensworth-dev/King-crimson-/main/chroma-keyed-video%20(1).webm"
local FILE_NAME = "DodgeIcon.png"
local VIDEO_FILE = "EraseEffect.webm"
local AFTERIMAGE_COLOR = Color3.fromRGB(255, 0, 0)

-- // Asset Handling with Error Printing
local function loadAsset(fileName, url)    
    local success, content = pcall(readfile, fileName)
    if not success then
        print("File not found, downloading: " .. fileName)
        local dlSuccess, dlContent = pcall(function() return game:HttpGet(url) end)
        if dlSuccess then
            writefile(fileName, dlContent)
            print("Successfully downloaded: " .. fileName)
        else
            print("ERROR: Failed to download " .. fileName .. " | " .. tostring(dlContent))
            return ""
        end
    end
    return getcustomasset(fileName)
end

-- // Core Setup
local cloneref = cloneref or function(o) return o end
local coregui = cloneref(game:GetService("CoreGui"))
local parentTarget = coregui or player:WaitForChild("PlayerGui")

-- // UI Creation
local gui = Instance.new("ScreenGui", parentTarget)
gui.Name = "TeleportGui"
gui.IgnoreGuiInset = true
gui.ResetOnSpawn = false
gui.DisplayOrder = 10

-- Video Frame
local videoFrame = Instance.new("VideoFrame", gui)
videoFrame.Name = "EraseVideo"
videoFrame.BackgroundTransparency = 1
videoFrame.Size = UDim2.new(1, 0, 1, 0)
videoFrame.Position = UDim2.new(0, 0, 0, 0)
videoFrame.Visible = false
videoFrame.Volume = 0
videoFrame.Looped = false
videoFrame.ZIndex = 1

-- Load Assets
videoFrame.Video = loadAsset(VIDEO_FILE, VIDEO_URL)

local imageButton = Instance.new("ImageButton", gui)
imageButton.Name = "DodgeButton"
imageButton.Size = UDim2.new(0, 80, 0, 80)
imageButton.Position = UDim2.new(0.85, 0, 0.75, 0)
imageButton.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
imageButton.BackgroundTransparency = 0.3
imageButton.Image = loadAsset(FILE_NAME, IMAGE_URL)
imageButton.ScaleType = Enum.ScaleType.Fit
imageButton.BorderSizePixel = 0
imageButton.ZIndex = 10

local uiCorner = Instance.new("UICorner", imageButton)
uiCorner.CornerRadius = UDim.new(1, 0)

-- // Draggable Logic
local dragging, dragStart, startPos
imageButton.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = imageButton.Position
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then dragging = false end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - dragStart
		imageButton.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
end)

-- // VFX Functions
local function createAfterImage(sourceChar)
	sourceChar.Archivable = true
	local clone = sourceChar:Clone()
	sourceChar.Archivable = false
	for _, obj in ipairs(clone:GetDescendants()) do
		if obj:IsA("BasePart") then
			obj.Anchored, obj.CanCollide, obj.Material, obj.Color = true, false, Enum.Material.ForceField, AFTERIMAGE_COLOR
		elseif obj:IsA("Script") or obj:IsA("LocalScript") or obj:IsA("Sound") then
			obj:Destroy()
		end
	end
	clone.Parent = workspace
	for _, obj in ipairs(clone:GetDescendants()) do
		if obj:IsA("BasePart") or obj:IsA("Decal") then
			TweenService:Create(obj, TweenInfo.new(GHOST_DURATION), {Transparency = 1}):Play()
		end
	end
	task.delay(GHOST_DURATION, function() clone:Destroy() end)
end

-- // Trigger
imageButton.Activated:Connect(function()
	if not canDash then return end
	canDash = false
	
	-- Play Sound
	local sound = Instance.new("Sound", rootPart)
	sound.SoundId = SOUND_ID
	sound:Play()
	sound.Ended:Connect(function() sound:Destroy() end)
	
	createAfterImage(character)
	
	-- Teleport
	rootPart.CFrame = rootPart.CFrame + (rootPart.CFrame.LookVector * DISTANCE)

	-- Play Video
	videoFrame.Visible = true
	videoFrame.TimePosition = 0
	videoFrame:Play()
	
	task.delay(1.2, function()
		videoFrame:Pause()
		videoFrame.Visible = false
	end)
	
	-- UI Feedback
	imageButton:TweenSize(UDim2.new(0, 70, 0, 70), "Out", "Quad", 0.1, true)
	task.delay(0.1, function()
		imageButton:TweenSize(UDim2.new(0, 80, 0, 80), "Out", "Quad", 0.1, true)
	end)
	
	task.wait(COOLDOWN)
	canDash = true
end)
