-- // Draggable Logic
local dragging, dragInput, dragStart, startPos
local function update(input)
	local delta = input.Position - dragStart
	imageButton.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
end
imageButton.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging, dragStart, startPos = true, input.Position, imageButton.Position
		input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then dragging = false end end)
	end
end)
imageButton.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end
end)
UserInputService.InputChanged:Connect(function(input)
	if input == dragInput and dragging then update(input) end
end)

-- // --- SHARED VIEWPORT ASSETS ---
local sharedWorld = worldTemplate:Clone()
local sharedCam = Instance.new("Camera")

-- // GLITCH GENERATOR
local function createGlitchLine()
    local line = Instance.new("Frame", screenGui)
    line.BorderSizePixel, line.ClipsDescendants, line.BackgroundColor3 = 0, true, Color3.new(0,0,0)
    line.Size = UDim2.new(math.random(30, 100)/100, 0, 0, math.random(5, 50))
    line.Position = UDim2.new(math.random(-10, 10)/100, 0, math.random(0, 100)/100, 0)
    
    local vp = Instance.new("ViewportFrame", line)
    vp.Size, vp.BackgroundTransparency = UDim2.new(1, 0, 1, 0), 1
    
    sharedWorld.Parent = vp
    vp.CurrentCamera = sharedCam
    
    sharedCam.CFrame = CFrame.new(Vector3.new(math.random(-150, 150), math.random(10, 50), math.random(-150, 150)), Vector3.new(0,0,0))
    
    -- Safety Cleanup: reparent world before the line is destroyed to prevent sticking
    task.delay(math.random(4, 15)/100, function()
        sharedWorld.Parent = nil
        line:Destroy()
    end)
end

-- // Trigger
imageButton.Activated:Connect(function()
    if not canUse then return end
    
    local character = player.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end
    
    canUse = false
    
    task.spawn(function()
        for i = 1, 65 do 
            createGlitchLine()
            if i % 6 == 0 then RunService.RenderStepped:Wait() end
        end
    end)

	local sound = Instance.new("Sound", rootPart)
	sound.SoundId, sound.Volume = SOUND_ID, 1.5
	sound:Play()
	Debris:AddItem(sound, 2)

	character.Archivable = true
	local clone = character:Clone()
	character.Archivable = false
	for _, obj in ipairs(clone:GetDescendants()) do
		if obj:IsA("BasePart") then
			obj.Anchored, obj.CanCollide, obj.Material, obj.Color = true, false, Enum.Material.ForceField, AFTERIMAGE_COLOR
			TweenService:Create(obj, TweenInfo.new(GHOST_DURATION), {Transparency = 1}):Play()
		elseif obj:IsA("Script") or obj:IsA("LocalScript") then obj:Destroy() end
	end
	clone.Parent = workspace
	Debris:AddItem(clone, GHOST_DURATION)
	
	rootPart.CFrame = rootPart.CFrame + (rootPart.CFrame.LookVector * DISTANCE)
	
	imageButton:TweenSize(UDim2.new(0, 70, 0, 70), "Out", "Quad", 0.1, true)
	task.delay(0.1, function() 
        imageButton:TweenSize(UDim2.new(0, 80, 0, 80), "Out", "Quad", 0.1, true) 
    end)
    
    task.wait(COOLDOWN_TIME)
    canUse = true
end)
