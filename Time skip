local Players = game:GetService("Players")
local plr = Players.LocalPlayer

local img = "https://raw.githubusercontent.com/alexanderhensworth-dev/King-crimson-/main/Glossy%20button%20(3).png"
local fName = "dodgeicon3.png" 

local function loadAsset(f, url)    
    local s, res = pcall(readfile, f)
    if not s then
        print("no file, downloading... " .. f)
        local dls, dlContent = pcall(function() return game:HttpGet(url) end)
        if dls then
            writefile(f, dlContent)
            print("got it")
        else
            print("failed download: " .. tostring(dlContent))
            return ""
        end
    end
    return getcustomasset(f)
end

local coregui = (cloneref or function(o) return o end)(game:GetService("CoreGui"))
local parent = coregui or plr:WaitForChild("PlayerGui")

local gui = Instance.new("ScreenGui", parent)
gui.Name = "TeleportGui"
gui.IgnoreGuiInset = true
gui.ResetOnSpawn = false
gui.DisplayOrder = 10

local vf = Instance.new("VideoFrame", gui)
vf.Name = "EraseVideo"
vf.BackgroundTransparency = 1
vf.Size = UDim2.new(1, 0, 1, 0)
vf.Visible = false
vf.Volume = 0
vf.ZIndex = 1

local vidUrl = "https://raw.githubusercontent.com/alexanderhensworth-dev/King-crimson-/main/chroma-keyed-video%20(1).webm"
vf.Video = loadAsset("EraseEffect.webm", vidUrl)

local btn = Instance.new("ImageButton", gui)
btn.Name = "DodgeButton"
btn.Size = UDim2.new(0, 80, 0, 80)
btn.Position = UDim2.new(0.85, 0, 0.75, 0)
btn.BackgroundTransparency = 1 
btn.Image = loadAsset(fName, img)
btn.ScaleType = Enum.ScaleType.Fit
btn.BorderSizePixel = 0
btn.ZIndex = 10

local drag, dStart, sPos
local uis = game:GetService("UserInputService")

btn.InputBegan:Connect(function(i)
	if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
		drag = true
		dStart = i.Position
		sPos = btn.Position
		i.Changed:Connect(function()
			if i.UserInputState == Enum.UserInputState.End then drag = false end
		end)
	end
end)

uis.InputChanged:Connect(function(i)
	if drag and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
		local delta = i.Position - dStart
		btn.Position = UDim2.new(sPos.X.Scale, sPos.X.Offset + delta.X, sPos.Y.Scale, sPos.Y.Offset + delta.Y)
	end
end)

local ts = game:GetService("TweenService")
local cd = false

local function createAfterImage(char)
	char.Archivable = true
	local cl = char:Clone()
	char.Archivable = false
	for _, o in ipairs(cl:GetDescendants()) do
		if o:IsA("BasePart") then
			o.Anchored, o.CanCollide, o.Material, o.Color = true, false, Enum.Material.ForceField, Color3.fromRGB(255, 0, 0)
		elseif o:IsA("Script") or o:IsA("LocalScript") or o:IsA("Sound") then
			o:Destroy()
		end
	end
	cl.Parent = workspace
	for _, o in ipairs(cl:GetDescendants()) do
		if o:IsA("BasePart") or o:IsA("Decal") then
			ts:Create(o, TweenInfo.new(0.35), {Transparency = 1}):Play()
		end
	end
	task.delay(0.35, function() cl:Destroy() end)
end

btn.Activated:Connect(function()
	if cd then return end
	local char = plr.Character if not char then return end
	local root = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChild("Humanoid")
	if not root or not hum or hum.Health <= 0 then return end
	
	cd = true
	
	local sound = Instance.new("Sound", root)
	sound.SoundId = "rbxassetid://123891403807633"
	sound:Play()
	sound.Ended:Connect(function() sound:Destroy() end)
	
	createAfterImage(char)
	root.CFrame = root.CFrame + (root.CFrame.LookVector * 20)

	vf.Visible = true
	vf.TimePosition = 0
	vf:Play()
	
	task.delay(1.2, function()
		vf:Pause()
		vf.Visible = false
	end)
	
	btn:TweenSize(UDim2.new(0, 70, 0, 70), "Out", "Quad", 0.1, true)
	task.delay(0.1, function() btn:TweenSize(UDim2.new(0, 80, 0, 80), "Out", "Quad", 0.1, true) end)
	
	task.wait(2)
	cd = false
end)
